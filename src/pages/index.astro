---
import '../styles/global.css';
import { Font } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import productsData from '../data/products.json';
import site from '../data/site.json';
import { parseCatalog, pageOrder } from '../../shared/catalog.ts';
import HowToBuy from '../components/HowToBuy.astro';
import ProductCard from '../components/ProductCard.astro';
import ContactFooter from '../components/ContactFooter.astro';

const number = (import.meta.env.PUBLIC_WHATSAPP_NUMBER ?? '').replace(/\D/g, '');
if (!number) throw new Error('Falta PUBLIC_WHATSAPP_NUMBER');

// Invalid catalog data fails the build, so the last good version stays live.
const products = pageOrder(parseCatalog(productsData).products);

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/products/**/*.{jpg,png,webp}',
  { eager: true },
);
function imageFor(path: string): ImageMetadata {
  const mod = images[`/src/assets/products/${path}`];
  if (!mod) throw new Error(`Falta la foto ${path}`);
  return mod.default;
}

const firstInStock = products.find((p) => p.inStock);
const ogImage =
  Astro.site && firstInStock ? new URL(`/fotos/${firstInStock.photos[0]}`, Astro.site).href : undefined;
const hasGallery = products.some((p) => p.photos.length > 1);
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.shopName}</title>
    <meta name="description" content={site.tagline} />
    <meta property="og:title" content={site.shopName} />
    <meta property="og:description" content={site.tagline} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="theme-color" content="#FFFBF2" />
    <Font cssVariable="--font-body" preload />
  </head>
  <body>
    <main>
      <header class="header">
        <h1>{site.shopName}</h1>
        <p class="tagline">{site.tagline}</p>
      </header>

      <HowToBuy />

      {
        products.length === 0 ? (
          <p class="empty">Muy pronto vas a ver acá las piezas de Norma.</p>
        ) : (
          <div class="list">
            {products.map((product, index) => (
              <ProductCard
                product={product}
                images={product.photos.map(imageFor)}
                number={number}
                eager={index < 2}
              />
            ))}
          </div>
        )
      }

      <ContactFooter number={number} />
    </main>

    {
      hasGallery && (
        <script is:inline>
          document.querySelectorAll('[data-gallery]').forEach(function (g) {
            var track = g.querySelector('[data-track]');
            var label = g.querySelector('[data-label]');
            var n = track.children.length;
            function cur() { return Math.round(track.scrollLeft / track.clientWidth); }
            function go(d) {
              var i = Math.min(n - 1, Math.max(0, cur() + d));
              track.scrollTo({ left: i * track.clientWidth, behavior: 'smooth' });
            }
            g.querySelector('[data-prev]').addEventListener('click', function () { go(-1); });
            g.querySelector('[data-next]').addEventListener('click', function () { go(1); });
            track.addEventListener('scroll', function () {
              label.textContent = 'Foto ' + (cur() + 1) + ' de ' + n;
            }, { passive: true });
          });
        </script>
      )
    }
  </body>
</html>
